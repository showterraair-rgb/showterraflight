# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Public API URL for absolute links in PDFs (production: https://api.yourdomain.com)
API_PUBLIC_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/show_terra_air

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=sta_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS
CLIENT_PUBLIC_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
INACTIVITY_TIMEOUT_MINUTES=30

# Backup
BACKUP_DIR=uploads/backups
BACKUP_CRON=0 2 * * *

# BulkSMSBD (optional — can also configure in Admin → SMS Settings)
# BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
# BULKSMSBD_BALANCE_URL=http://bulksmsbd.net/api/getBalanceApi
# BULKSMSBD_API_KEY=your_api_key
# BULKSMSBD_SENDER_ID=8809617626936
# BULKSMSBD_ENABLED=true

# Main admin (full access — or run: npm run create-admin-user)
# SEED_ADMIN_EMAIL=admin@showterraair.com
# SEED_ADMIN_PASSWORD=Admin@123456

# Demo user (read-only preview — or run: npm run create-demo-user)
# DEMO_USER_EMAIL=demo@showterraair.com
# DEMO_USER_PASSWORD=Demo@123456
# DEMO_USER_ROLE=demo
# SEED_DEMO_USER=true

# --- Production (see deploy/env/backend.production.env.example) ---
# NODE_ENV=production
# COOKIE_SECURE=true
# CLIENT_PUBLIC_URL=https://showterraair.com
# CLIENT_ADMIN_URL=https://admin.showterraair.com
