# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Public API URL for absolute links in PDFs (production: https://api.yourdomain.com)
API_PUBLIC_URL=http://localhost:5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/show_terra_air

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=sta_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS
CLIENT_PUBLIC_URL=http://localhost:5173
CLIENT_ADMIN_URL=http://localhost:5174

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
INACTIVITY_TIMEOUT_MINUTES=30

# Backup
BACKUP_DIR=uploads/backups
BACKUP_CRON=0 2 * * *

# BulkSMSBD SMS gateway (https://bulksmsbd.net)
BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
BULKSMSBD_BALANCE_URL=http://bulksmsbd.net/api/getBalanceApi
BULKSMSBD_API_KEY=your_bulksmsbd_api_key
BULKSMSBD_SENDER_ID=8809648909214
BULKSMSBD_IS_MASKING=false
BULKSMSBD_ENABLED=true

# WhatsApp Cloud API (optional — can also configure in Admin → WhatsApp Settings)
# WHATSAPP_ACCESS_TOKEN=your_permanent_or_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_random_verify_string
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=880
# WHATSAPP_DEFAULT_LANGUAGE=en
# WHATSAPP_TEST_TEMPLATE=hello_world
# WHATSAPP_ENABLED=true
# Webhook URL for Meta: https://api.yourdomain.com/api/v1/webhooks/whatsapp

# Wasender API — WhatsApp notifications (https://wasenderapi.com)
# Use the Session API key from: WhatsApp session → Credentials tab (NOT Personal Access Token)
# Session "Show Terra Air" ID: 96259 | Phone: +8801741148529
WASENDER_API_URL=https://www.wasenderapi.com/api/send-message
WASENDER_API_KEY=your_wasender_session_api_key
WASENDER_ENABLED=true

# Gmail SMTP (use App Password — not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your@gmail.com
SMTP_FROM_NAME=Show Terra Flight
SMTP_ENCRYPTION=tls
SMTP_ENABLED=true

# Main admin (full access — or run: npm run create-admin-user)
# SEED_ADMIN_EMAIL=admin@showterraair.com
# SEED_ADMIN_PASSWORD=Admin@123456

# Demo user (read-only preview — or run: npm run create-demo-user)
# DEMO_USER_EMAIL=demo@showterraair.com
# DEMO_USER_PASSWORD=Demo@123456
# DEMO_USER_ROLE=demo
# SEED_DEMO_USER=true

# --- Production (see deploy/env/backend.production.env.example) ---
# NODE_ENV=production
# COOKIE_SECURE=true
# CLIENT_PUBLIC_URL=https://showterraair.com
# CLIENT_ADMIN_URL=https://admin.showterraair.com
