# Show Terra Air — Production backend environment
# Copy to: /var/www/show-terra-air/backend/.env
# NEVER commit real secrets to git.

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# MongoDB — localhost only; enable auth in production (see docs/SERVER-HARDENING.md)
MONGODB_URI=mongodb://127.0.0.1:27017/show_terra_air

# JWT — generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=sta_token

# Cookies — REQUIRED for HTTPS production
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# CORS — must match your live frontends exactly (including https)
CLIENT_PUBLIC_URL=https://showterraflight.com
CLIENT_ADMIN_URL=https://admin.showterraflight.com
CLIENT_AGENT_URL=https://agent.showterraflight.com
JWT_AGENT_COOKIE_NAME=sta_agent_token

# Uploads & backups (paths relative to backend/ or absolute)
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
BACKUP_DIR=uploads/backups
BACKUP_CRON=0 2 * * *

# Security
RATE_LIMIT_WINDOW_MS=900000
# Anonymous/public API only — logged-in admin/agent sessions are excluded from this cap.
RATE_LIMIT_MAX=300
INACTIVITY_TIMEOUT_MINUTES=30

# BulkSMSBD SMS gateway (bulksmsbd.net)
BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
BULKSMSBD_BALANCE_URL=http://bulksmsbd.net/api/getBalanceApi
BULKSMSBD_API_KEY=REPLACE_WITH_YOUR_API_KEY
BULKSMSBD_SENDER_ID=+8809617626936
BULKSMSBD_IS_MASKING=false
BULKSMSBD_ENABLED=true

# Wasender WhatsApp — https://wasenderapi.com (session API key from Credentials tab)
WASENDER_API_URL=https://www.wasenderapi.com/api/send-message
WASENDER_API_KEY=REPLACE_WITH_SESSION_API_KEY
WASENDER_ENABLED=true

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_GMAIL
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
SMTP_FROM=REPLACE_WITH_GMAIL
SMTP_FROM_NAME=Show Terra Flight
SMTP_ENCRYPTION=tls
SMTP_ENABLED=true
