# Show Terra Air — Production backend environment
# Copy to: /var/www/show-terra-air/backend/.env
# NEVER commit real secrets to git.

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# MongoDB — localhost only; enable auth in production (see docs/SERVER-HARDENING.md)
MONGODB_URI=mongodb://127.0.0.1:27017/show_terra_air

# JWT — generate: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=sta_token

# Cookies — REQUIRED for HTTPS production
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# CORS — must match your live frontends exactly (including https)
CLIENT_PUBLIC_URL=https://showterraair.com
CLIENT_ADMIN_URL=https://admin.showterraair.com

# Uploads & backups (paths relative to backend/ or absolute)
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads
BACKUP_DIR=uploads/backups
BACKUP_CRON=0 2 * * *

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
INACTIVITY_TIMEOUT_MINUTES=30

# BulkSMSBD SMS gateway (bulksmsbd.net)
BULKSMSBD_API_URL=http://bulksmsbd.net/api/smsapi
BULKSMSBD_BALANCE_URL=http://bulksmsbd.net/api/getBalanceApi
BULKSMSBD_API_KEY=REPLACE_WITH_YOUR_API_KEY
BULKSMSBD_SENDER_ID=8809617626936
BULKSMSBD_ENABLED=true
